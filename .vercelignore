# Excluded from the upload when deploying with the Vercel CLI (`vercel`, which packs
# the working directory). A Git-based import clones the repository instead and ignores
# this file, which is why everything the build needs stays out of here: vercel.json
# configures the build, package.json declares it, tools/build.js runs it, src/ is the
# site, and public/ is regenerated by the build step.
#
# The legacy single-file build is 13 MB of the same code that already ships split up
# and cacheable, so it does not need to travel to the build machine.
VALORANT/
public/
.git
node_modules/
*.log
.DS_Store
